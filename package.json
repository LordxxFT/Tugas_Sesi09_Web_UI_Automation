{
    "name": "selenium-webdriver-tugas-09",
    "version": "1.0.0",
    "description": "Tugas 09 Selenium WebDriver tests using Mocha with Mochawesome reports",
    "scripts": {
        "Test-Tugas-09": "mocha test/sesi-9/test_sesi9.js  --recursive --timeout 60000",
        "Tugas-09-mochawesome": "mocha test/sesi-9/test_sesi9.js  --recursive --timeout 60000 --reporter mochawesome",
        "Tugas-09-simple-html": "mocha test/sesi-9/test_sesi9.js  --recursive --timeout 60000 --reporter mocha-simple-html-reporter --reporter-options output=report.html"
    },
    "dependencies": {
        "ajv": "^8.17.1",
        "selenium-webdriver": "^4.17.0"
    },
    "devDependencies": {
        "chai": "^5.2.1",
        "exceljs": "^4.4.0",
        "mocha": "^10.8.2",
        "mocha-simple-html-reporter": "^2.0.0",
        "mochawesome": "^7.1.3"
    },
    "main": "index.js",
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "commonjs"
}
